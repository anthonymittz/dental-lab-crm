{
  "compilerOptions": {
    "checkJs": true,
    "noImplicitAny": false,
    "noUncheckedSideEffectImports": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./libs/*"]
    }
  },
  "include": ["src/**/*", "libs/**/*", "src/index.d.ts"],
  "exclude": ["node_modules", "dist", "out"]
}